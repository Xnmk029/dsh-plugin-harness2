{
  "name": "dsh-plugin-harness2",
  "description": "Harness² seams for the DeepSeek Harness: literal prompt sections, a trajectory recorder, and tool guards, packaged as an out-of-tree bundle",
  "version": "0.1.0",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "harness2",
    "bundle"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.probe.patch.yml": "./cordis.probe.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.json",
    "build:js": "tsdown",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "watch": "tsdown --watch",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "@types/node": "^22.20.5",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.2.39"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "cordis.probe.patch.yml",
    "locale/*.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
